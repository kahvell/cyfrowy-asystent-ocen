# Skopiuj do .env:  cp .env.example .env

# --- baza danych ---
# docker compose: Postgres (ustawiane w docker-compose.yml)
# lokalnie bez Dockera: SQLite (domyślnie sqlite:///./app.db)
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

JWT_SECRET=zmien-mnie-na-losowy-ciag-min-32-znaki

# --- model językowy ---
# local    = Ollama / vLLM w urzędzie - dane nie opuszczają serwera (zalecane)
# external = zewnętrzne API (tylko dev/demo) - dane są pseudonimizowane przed wysłaniem
# fake     = bez modelu, tylko reguły i heurystyki (testy, CI, demo offline)
LLM_MODE=local
# PLLuM 12B instruct (model rządowy, licencja Apache 2.0) - GGUF z HuggingFace:
#   ollama pull hf.co/mradermacher/PLLuM-12B-instruct-2512-GGUF:Q4_K_M
LLM_MODEL=ollama_chat/hf.co/mradermacher/PLLuM-12B-instruct-2512-GGUF:Q4_K_M
# alternatywy:
#   ollama_chat/SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M   (Bielik)
#   anthropic/<model> | openai/<model>                        (LLM_MODE=external)
LLM_API_KEY=
EMBEDDING_MODEL=ollama/bge-m3
# backend uruchomiony bez Dockera:
OLLAMA_BASE_URL=http://localhost:11434
# backend w docker compose: domyślnie Ollama na hoście (host.docker.internal);
# przy profilu local-llm (Ollama w kontenerze) odkomentuj:
# DOCKER_OLLAMA_BASE_URL=http://ollama:11434
# gdy model nie odpowiada -> reguły zamiast błędu (oznaczone w UI)
LLM_HEURISTIC_FALLBACK=true

PSEUDONYMIZE=true
SEED_DEMO_DATA=true
K_ANONYMITY=5

# --- powiadomienia e-mail (bez SMTP_HOST powiadomienia są tylko w systemie) ---
# demo: testowa skrzynka Mailpit (docker compose ją uruchamia) -> http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
# w urzędzie: serwer poczty urzędu (+ w docker compose: DOCKER_SMTP_HOST=smtp.urzad.gov.pl)
# SMTP_HOST=smtp.urzad.gov.pl
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=asystent-ocen@urzad.gov.pl
# APP_URL=https://oceny.urzad.gov.pl
# codzienne przypomnienia o terminach (cron / harmonogram zadań):  python -m app.services.notify digest
